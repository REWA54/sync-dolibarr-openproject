# Pour lancer l'outil depuis un poste de développement, contre de vraies instances :
#   cp .env.exemple .env && chmod 600 .env
#   uv run --env-file .env dolop verifier      (puis « dolop simuler »)
# Le fichier .env n'est jamais versionné. Pour un déploiement, voir compose.env.exemple.
DOLIBARR_URL=https://dolibarr.example.org
DOLIBARR_API_KEY=
OPENPROJECT_URL=https://openproject.example.org
OPENPROJECT_API_KEY=
# Comptes jamais synchronisés, ni eux ni leurs temps : les administrateurs et le compte technique.
EXCLURE_LOGINS=admin,sync
# Nom exact du type de lot utilisé pour les tâches venues de Dolibarr (« Task », « Tache »…).
OPENPROJECT_TYPE=Task
# Base d'état locale : ne jamais faire tourner le service ici ET sur le serveur.
BASE_ETAT=./etat-local.sqlite
