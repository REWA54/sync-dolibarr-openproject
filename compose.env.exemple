# Configuration du déploiement Docker Compose. Copier en « .env » à côté de compose.yaml,
# puis « chmod 600 .env » : ce fichier contient deux jetons administrateur.

# Image : toujours une version précise (voir la page Releases), jamais « latest ».
DOLOP_IMAGE=ghcr.io/rewa54/sync-dolibarr-openproject:v0.2.0

# Adresses des API. Par un réseau Docker partagé, les noms des conteneurs suffisent :
#   DOLOP_DOLIBARR_URL=http://dolibarr  et  DOLOP_OPENPROJECT_URL=http://openproject-proxy
DOLOP_DOLIBARR_URL=https://dolibarr.example.org
DOLOP_OPENPROJECT_URL=https://openproject.example.org
# Nom public d'OpenProject, seulement si DOLOP_OPENPROJECT_URL est une adresse interne.
DOLOP_OPENPROJECT_HOST=

# Jetons des comptes techniques (docs/preparation.md, étapes A2 et B2).
DOLOP_DOLIBARR_API_KEY=
DOLOP_OPENPROJECT_API_KEY=

# Comptes jamais synchronisés : les administrateurs et le compte technique de chaque outil.
DOLOP_EXCLURE_LOGINS=admin,sync
# Nom exact du type de lot (« Task », ou « Tache » dans une instance installée en français).
DOLOP_OPENPROJECT_TYPE=Task
# Webhook d'alerte (Home Assistant ou autre, format {"title", "message"}). Vide : journal seulement.
DOLOP_WEBHOOK=

# Dossier de l'hôte pour la base d'état et ses sauvegardes, propriété de l'uid 1000.
DOLOP_DONNEES=./donnees
# Réseau Docker partagé avec Dolibarr et OpenProject (ou « docker network create dolop »).
DOLOP_RESEAU=dolop
DOLOP_FUSEAU=Europe/Paris
